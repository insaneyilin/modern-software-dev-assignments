<!-- app/views/notes/_search.html.erb -->
<%= form_with url: search_notes_path,
              method: :get,
              data: { controller: "search", search_delay_value: 800 },
              class: "relative" do |f| %>
  <%= f.text_field :q,
                   value: query,
                   placeholder: "搜索笔记...",
                   autocomplete: "off",
                   class: "w-full px-4 py-2 pl-10 pr-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500",
                   data: { search_target: "input",
                           action: "input->search#submit keydown->search#submitNow compositionstart->search#compositionStart compositionend->search#compositionEnd" } %>

  <!-- 搜索图标 -->
  <svg class="absolute left-3 top-2.5 h-5 w-5 text-gray-400 pointer-events-none"
       fill="none"
       stroke="currentColor"
       viewBox="0 0 24 24">
    <path stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>

  <!-- 清空按钮 -->
  <% if query.present? %>
    <%= link_to root_path,
                class: "absolute right-3 top-2.5 text-gray-400 hover:text-gray-600",
                title: "清空搜索" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    <% end %>
  <% end %>
<% end %>
