<!-- app/views/notes/_editor.html.erb -->
<% if note.new_record? %>
  <div class="flex-1 flex items-center justify-center bg-white">
    <div class="text-center text-gray-400">
      <p class="text-lg">选择或创建一个笔记</p>
    </div>
  </div>
<% else %>
  <%= turbo_frame_tag "editor", target: "_top" do %>
    <div class="flex-1 flex flex-col bg-white h-full overflow-hidden">
      <%= form_with model: note,
                    data: { controller: "autosave", autosave_delay_value: 1000 },
                    class: "flex-1 flex flex-col min-h-0" do |f| %>
        <div class="p-8 flex-1 flex flex-col min-h-0 overflow-hidden">
          <%= f.text_field :title,
                           value: note.title,
                           placeholder: "Untitled",
                           class: "text-3xl font-bold mb-4 outline-none border-none focus:ring-0 bg-transparent",
                           data: { action: "input->autosave#save", autosave_target: "title" } %>

          <%= f.text_area :content,
                          value: note.content,
                          placeholder: "开始写作...",
                          class: "flex-1 outline-none border-none resize-none focus:ring-0 text-lg leading-relaxed bg-transparent min-h-0",
                          data: { action: "input->autosave#save", autosave_target: "content" } %>

          <div class="text-sm text-gray-400 mt-2 flex-shrink-0" data-autosave-target="status">
            所有更改已保存
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
